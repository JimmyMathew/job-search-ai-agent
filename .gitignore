.venv/
__pycache__/
*.pyc

# Anything private kept in secrets/ stays local
secrets/*
!secrets/.gitkeep
!secrets/README.md

# The drop folder for your resume: only the reminder is tracked
resume/*
!resume/README.txt

runs/

.env

# Every real person's profile (resume, profile.md, sheet address) stays local.
# Only the fictional template is shared.
profiles/*
!profiles/_example/

# Resumes and personal documents, wherever they end up
*.pdf
*.docx

# Job lists (Excel), the lock files Excel and LibreOffice leave beside them, and the
# agent's own lock and half-written temporary files
*.xlsx
~$*
.~lock.*#
.*.agent-lock
.*.saving.xlsx

# Original design notes mention a specific person; keep local only
LinkedIn Job Search Agent Plan.md
